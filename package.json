    "db:sync:tfl": "tsx prisma/sync-tfl.ts",
    "db:sync:simulation": "tsx prisma/sync-simulation.ts",
    "db:sample:tfl": "tsx prisma/sample-status.ts",
    "db:predict": "tsx prisma/predict-reliability.ts",
    "db:studio": "prisma studio",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "worker": "tsx worker/index.ts",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
