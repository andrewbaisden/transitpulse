// TransitPulse — Phase 1-3 domain schema.
// See ARCHITECTURE.md for the provider -> ingestion -> Postgres pipeline this
// schema sits at the end of, and DECISIONS.md for the ADRs behind the
// modelling choices below (self-referential Stop hierarchy, append-only
// ServiceStatus, (source, externalRef) provenance instead of a mapping table).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransportMode {
  TUBE
  OVERGROUND
  ELIZABETH_LINE
  DLR
  BUS
  TRAM
}

enum StopType {
  HUB // multi-station interchange complex
  STATION
  PLATFORM
}

enum ServiceStatusLevel {
  GOOD_SERVICE
  MINOR_DELAYS
  SEVERE_DELAYS
  PART_CLOSURE
  SUSPENDED
  SPECIAL_SERVICE
  UNKNOWN
}

model Network {
  id        String   @id @default(cuid())
  name      String   @unique // "London" — deliberately future-proofs multi-network
  timezone  String   @default("Europe/London")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines Line[]

  @@map("networks")
}

model Line {
  id        String        @id @default(cuid())
  name      String
  mode      TransportMode
  color     String? // hex branding colour, not all sources provide one
  networkId String
  network   Network       @relation(fields: [networkId], references: [id])

  // Provenance: which provider populated this row, and that provider's own id
  // for it. Not a separate mapping table — see DECISIONS.md ADR-005.
  source      String
  externalRef String

  stops                  LineStop[]
  serviceStatus          ServiceStatus[]
  reliabilityPredictions ReliabilityPrediction[]
  favourites             Favourite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalRef])
  @@index([mode])
  @@map("lines")
}

model Stop {
  id       String   @id @default(cuid())
  name     String
  stopType StopType

  // Self-referential hierarchy (HUB > STATION > PLATFORM), matching TfL's
  // real StopPoint model so the Phase 4 TfL adapter maps across without a
  // schema change. See DECISIONS.md ADR-003.
  parentId String?
  parent   Stop?   @relation("StopHierarchy", fields: [parentId], references: [id])
  children Stop[]  @relation("StopHierarchy")

  lat Float?
  lon Float?

  source      String
  externalRef String

  lines      LineStop[]
  favourites Favourite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalRef])
  @@index([stopType])
  @@index([parentId])
  @@index([name])
  @@map("stops")
}

model LineStop {
  id       String @id @default(cuid())
  lineId   String
  stopId   String
  sequence Int // ordering of the stop along the line

  line Line @relation(fields: [lineId], references: [id])
  stop Stop @relation(fields: [stopId], references: [id])

  @@unique([lineId, stopId])
  @@index([lineId, sequence])
  @@map("line_stops")
}

model ServiceStatus {
  id          String             @id @default(cuid())
  lineId      String
  line        Line               @relation(fields: [lineId], references: [id])
  status      ServiceStatusLevel
  description String?
  source      String
  recordedAt  DateTime // when the status was true, not necessarily row-insert time

  createdAt DateTime @default(now())

  // Append-only: every ingestion run inserts a new row rather than updating
  // one, so historical reliability aggregation (Phase 7+) is possible
  // without a migration. Phase 1-3 UI only reads the latest row per line.
  // The unique constraint makes re-ingesting the same provider snapshot
  // (same line/source/recordedAt) idempotent, while a genuinely new
  // recordedAt still appends a new history row.
  @@unique([lineId, source, recordedAt])
  @@index([lineId, recordedAt])
  @@map("service_statuses")
}

// Phase 12: a prediction is stored BEFORE its outcome is known — that's
// what makes "evaluated against actual outcomes" (ARCHITECTURE.md roadmap)
// meaningful rather than hindsight. `actualGoodServicePercent`/`evaluatedAt`
// stay null until the target window has passed and a later job fills them
// in from real ServiceStatus history. See DECISIONS.md ADR-023.
model ReliabilityPrediction {
  id     String @id @default(cuid())
  lineId String
  line   Line   @relation(fields: [lineId], references: [id])

  source            String
  predictedAt       DateTime // when this prediction was generated
  targetWindowStart DateTime
  targetWindowEnd   DateTime

  predictedGoodServicePercent Float
  algorithmVersion            Int

  actualGoodServicePercent Float?
  evaluatedAt              DateTime?

  createdAt DateTime @default(now())

  @@unique([lineId, source, targetWindowStart, targetWindowEnd])
  @@index([lineId, targetWindowEnd])
  @@map("reliability_predictions")
}

// Phase 14 — Better Auth's own core schema (self-hosted, no external
// account/API key needed — see DECISIONS.md ADR-025). Field shapes are
// exactly what better-auth@1.7.4's Prisma adapter expects at runtime
// (verified against its bundled schema definition, not assumed from
// memory) — @@map only renames the SQL table, Prisma's generated client
// property (prisma.user, prisma.session, ...) still comes from the model
// name above, which is what the adapter looks up by.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  favourites    Favourite[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// A favourite is either a line or a station, never both, never neither —
// enforced at the query-layer boundary (src/server/queries/favourites.ts),
// not by the schema itself (a DB-level XOR check across two nullable FKs
// isn't expressible as a plain Prisma unique constraint on Postgres, since
// NULL is never equal to NULL in a unique index). See DECISIONS.md
// ADR-025.
model Favourite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lineId String?
  line   Line?   @relation(fields: [lineId], references: [id], onDelete: Cascade)
  stopId String?
  stop   Stop?   @relation(fields: [stopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, lineId])
  @@unique([userId, stopId])
  @@map("favourites")
}
