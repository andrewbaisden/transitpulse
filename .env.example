DATABASE_URL="postgresql://transitpulse:transitpulse@localhost:5435/transitpulse"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="TransitPulse"

# Phase 14 (Better Auth) — generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="generate-your-own-secret-do-not-reuse-this-placeholder"
BETTER_AUTH_URL="http://localhost:3000"

# Phase 15 (observability) — both optional, both inert until set. No
# Sentry/PostHog account is provisioned for this project; leave unset in
# development. See DECISIONS.md ADR-026.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Phase 4 (TfL integration) — only used by `pnpm db:sync:tfl`, never by the
# app itself. Get a key at https://api-portal.tfl.gov.uk.
# TFL_APP_KEY=
